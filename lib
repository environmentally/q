-- UILib | simple client UI library | UILib.new{...} -> Window

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local UILib = {}
UILib.__index = UILib

local function create(className, properties, children)
	local instance = Instance.new(className)
	if properties then
		for key, value in properties do
			instance[key] = value
		end
	end
	for _, child in children do
		child.Parent = instance
	end
	return instance
end

local function round(object, radius, clip)
	object.ClipsDescendants = clip ~= false
	create("UICorner", { CornerRadius = UDim.new(0, radius) }, { object })
end

local function outline(object, color, thickness)
	create("UIStroke", {
		Color = color,
		Thickness = thickness,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, { object })
end

local function tween(object, properties, duration)
	local animation = TweenService:Create(object, TweenInfo.new(duration or 0.15, Enum.EasingStyle.Quad), properties)
	animation:Play()
	return animation
end

local function clamp(value, minimum, maximum)
	return math.max(minimum, math.min(maximum, value))
end

local Theme = {
	Background = Color3.fromRGB(22, 22, 26),
	Header = Color3.fromRGB(32, 32, 38),
	Element = Color3.fromRGB(42, 42, 50),
	ElementHover = Color3.fromRGB(56, 56, 66),
	Accent = Color3.fromRGB(90, 160, 255),
	Text = Color3.fromRGB(238, 238, 245),
	SubText = Color3.fromRGB(145, 145, 160),
	Border = Color3.fromRGB(62, 62, 74),
	Radius = 6,
	Font = Enum.Font.Gotham,
	TextSize = 14,
}

local function mergeTheme(overrides)
	local merged = {}
	for key, value in Theme do
		merged[key] = value
	end
	if overrides then
		for key, value in overrides do
			merged[key] = value
		end
	end
	return merged
end

UILib.Theme = Theme
UILib.Windows = {}
UILib.Minimized = {}

local function layoutMinimizedButtons()
	local count = #UILib.Minimized
	for index, window in ipairs(UILib.Minimized) do
		window.MinimizeButton.Position = UDim2.new(0, 4, 0.5, -count * 22 + (index - 1) * 44 + 22)
	end
end

UILib.new = function(options)
	options = options or {}

	local theme = mergeTheme(options.theme)
	local window = setmetatable({
		Theme = theme,
		Tabs = {},
		ActiveTab = nil,
		Minimized = false,
		Title = options.title or "UI",
	}, UILib)

	local gui = create("ScreenGui", {
		Name = "UILib_" .. tostring(#UILib.Windows + 1),
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 100 + #UILib.Windows,
	})
	gui.Parent = LocalPlayer:WaitForChild("PlayerGui")
	window.Gui = gui

	local root = create("Frame", {
		Name = "Window",
		BackgroundColor3 = theme.Background,
		BorderSizePixel = 0,
		Position = options.position or UDim2.fromOffset(120, 120),
		Size = options.size or UDim2.fromOffset(400, 320),
		Active = true,
	})
	root.Parent = gui
	round(root, theme.Radius)
	outline(root, theme.Border, 1)
	window.Root = root

	local header = create("Frame", {
		Name = "Header",
		BackgroundColor3 = theme.Header,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 34),
		Active = true,
	})
	header.Parent = root
	window.Header = header

	local title = create("TextLabel", {
		Name = "Title",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(12, 0),
		Size = UDim2.new(1, -80, 1, 0),
		Font = theme.Font,
		TextSize = theme.TextSize,
		TextColor3 = theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = window.Title,
	})
	title.Parent = header
	window.TitleLabel = title

	local closeButton = create("TextButton", {
		Name = "Close",
		AnchorPoint = Vector2.new(1, 0),
		BackgroundTransparency = 1,
		Position = UDim2.new(1, -6, 0, 5),
		Size = UDim2.fromOffset(24, 24),
		Font = theme.Font,
		TextSize = 15,
		TextColor3 = theme.SubText,
		Text = "✕",
		AutoButtonColor = false,
	})
	closeButton.Parent = header
	closeButton.MouseButton1Click:Connect(function()
		window:Destroy()
	end)

	local minimizeButton = create("TextButton", {
		Name = "Minimize",
		AnchorPoint = Vector2.new(1, 0),
		BackgroundTransparency = 1,
		Position = UDim2.new(1, -34, 0, 5),
		Size = UDim2.fromOffset(24, 24),
		Font = theme.Font,
		TextSize = 15,
		TextColor3 = theme.SubText,
		Text = "–",
		AutoButtonColor = false,
	})
	minimizeButton.Parent = header
	minimizeButton.MouseButton1Click:Connect(function()
		window:Minimize()
	end)

	local tabBar = create("Frame", {
		Name = "TabBar",
		BackgroundColor3 = theme.Header,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, 34),
		Size = UDim2.new(1, 0, 0, 30),
	})
	tabBar.Parent = root
	window.TabBar = tabBar

	local content = create("ScrollingFrame", {
		Name = "Content",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, 64),
		Size = UDim2.new(1, 0, 1, -64),
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = theme.Border,
		CanvasSize = UDim2.fromOffset(0, 0),
		Active = true,
	})
	content.Parent = root
	window.Content = content

	local minimizeEdgeButton = create("TextButton", {
		Name = "EdgeButton",
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundColor3 = theme.Header,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.fromOffset(30, 30),
		Visible = false,
		Font = theme.Font,
		TextSize = 16,
		TextColor3 = theme.Text,
		Text = "»",
		AutoButtonColor = false,
		ZIndex = 50,
	})
	minimizeEdgeButton.Parent = gui
	round(minimizeEdgeButton, theme.Radius)
	outline(minimizeEdgeButton, theme.Border, 1)
	minimizeEdgeButton.MouseButton1Click:Connect(function()
		window:Restore()
	end)
	window.MinimizeButton = minimizeEdgeButton

	local dragging = false
	local dragStart = Vector2.zero
	local dragOrigin = UDim2.new()

	header.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = UserInputService:GetMouseLocation()
			dragOrigin = root.Position
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if not dragging then
			return
		end
		if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		local delta = UserInputService:GetMouseLocation() - dragStart
		local position = UDim2.new(0, dragOrigin.X.Offset + delta.X, 0, dragOrigin.Y.Offset + delta.Y)
		local camera = workspace.CurrentCamera
		if camera then
			local view = camera.ViewportSize
			position = UDim2.new(
				0,
				clamp(position.X.Offset, -root.Size.X.Offset + 90, view.X - 90),
				0,
				clamp(position.Y.Offset, 0, view.Y - 60)
			)
		end
		root.Position = position
	end)

	UserInputService.InputUp:Connect(function()
		dragging = false
	end)

	table.insert(UILib.Windows, window)
	return window
end

function UILib:Minimize()
	if self.Minimized then
		return
	end
	self.Minimized = true
	self.Root.Visible = false
	self.MinimizeButton.Visible = true
	table.insert(UILib.Minimized, self)
	layoutMinimizedButtons()
end

function UILib:Restore()
	if not self.Minimized then
		return
	end
	self.Minimized = false
	self.Root.Visible = true
	self.MinimizeButton.Visible = false
	for index, window in ipairs(UILib.Minimized) do
		if window == self then
			table.remove(UILib.Minimized, index)
			break
		end
	end
	layoutMinimizedButtons()
end

function UILib:Toggle()
	if self.Minimized then
		self:Restore()
	else
		self:Minimize()
	end
end

function UILib:SetTitle(text)
	self.Title = text
	self.TitleLabel.Text = text
end

function UILib:SetPosition(position)
	self.Root.Position = position
end

function UILib:SetSize(size)
	self.Root.Size = size
end

function UILib:Center()
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local view = camera.ViewportSize
	self.Root.Position = UDim2.fromOffset(
		(view.X - self.Root.Size.X.Offset) / 2,
		(view.Y - self.Root.Size.Y.Offset) / 2
	)
end

function UILib:Destroy()
	for index, window in ipairs(UILib.Windows) do
		if window == self then
			table.remove(UILib.Windows, index)
			break
		end
	end
	for index, window in ipairs(UILib.Minimized) do
		if window == self then
			table.remove(UILib.Minimized, index)
			break
		end
	end
	layoutMinimizedButtons()
	self.Root:Destroy()
	self.MinimizeButton:Destroy()
	self.Gui:Destroy()
end

local function makeTab(window, name)
	local tab = setmetatable({
		Window = window,
		Name = name,
		Elements = {},
		Height = 0,
	}, { __index = UILib })

	local frame = create("Frame", {
		Name = name,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.new(1, -20, 0, 0),
		Position = UDim2.fromOffset(10, 0),
		Visible = false,
	})
	frame.Parent = window.Content
	tab.Frame = frame

	local button = create("TextButton", {
		Name = name,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(math.max(#name * 8 + 24, 50), 30),
		Font = window.Theme.Font,
		TextSize = window.Theme.TextSize,
		TextColor3 = window.Theme.SubText,
		Text = name,
		AutoButtonColor = false,
	})
	button.Parent = window.TabBar
	tab.Button = button

	local offset = 0
	for _, existing in ipairs(window.Tabs) do
		offset = offset + existing.Button.Size.X.Offset
	end
	button.Position = UDim2.fromOffset(offset + 6, 0)
	button.MouseButton1Click:Connect(function()
		window:SelectTab(tab)
	end)

	table.insert(window.Tabs, tab)
	if not window.ActiveTab then
		window:SelectTab(tab)
	end

	local function refresh()
		local y = 0
		for _, element in ipairs(tab.Elements) do
			element.Frame.Position = UDim2.fromOffset(0, y)
			y = y + element.Height + 6
		end
		tab.Height = y
		frame.Size = UDim2.new(1, -20, 0, y)
		if window.ActiveTab == tab then
			window.Content.CanvasSize = UDim2.new(1, 0, 0, math.max(y, 0))
		end
	end

	tab.Refresh = refresh
	tab.Add = function(element)
		element.Frame.Parent = frame
		element.Frame.Visible = true
		table.insert(tab.Elements, element)
		refresh()
		return element
	end

	return tab
end

function UILib:Tab(name)
	return makeTab(self, name or "Tab")
end

function UILib:SelectTab(tab)
	self.ActiveTab = tab
	for _, existing in ipairs(self.Tabs) do
		local active = existing == tab
		existing.Frame.Visible = active
		existing.Button.TextColor3 = active and self.Theme.Accent or self.Theme.SubText
	end
	self.Content.CanvasSize = UDim2.new(1, 0, 0, math.max(tab.Height, 0))
end

local function elementBase(tab, height)
	return {
		Frame = nil,
		Height = height,
		Tab = tab,
	}
end

function UILib:Label(text)
	local tab = self
	local theme = tab.Window.Theme
	local element = elementBase(tab, 20)

	local label = create("TextLabel", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 20),
		Font = theme.Font,
		TextSize = theme.TextSize,
		TextColor3 = theme.SubText,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = text,
	})
	element.Frame = label
	return tab.Add(element)
end

function UILib:Button(text, callback)
	local tab = self
	local theme = tab.Window.Theme
	local element = elementBase(tab, 34)

	local button = create("TextButton", {
		BackgroundColor3 = theme.Element,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 34),
		Font = theme.Font,
		TextSize = theme.TextSize,
		TextColor3 = theme.Text,
		Text = text,
		AutoButtonColor = false,
	})
	round(button, theme.Radius)
	button.MouseEnter:Connect(function()
		tween(button, { BackgroundColor3 = theme.ElementHover }, 0.12)
	end)
	button.MouseLeave:Connect(function()
		tween(button, { BackgroundColor3 = theme.Element }, 0.12)
	end)
	button.MouseButton1Click:Connect(function()
		if callback then
			callback()
		end
	end)

	element.Frame = button
	element.SetText = function(_, value)
		button.Text = value
	end
	return tab.Add(element)
end

function UILib:Toggle(text, default)
	local tab = self
	local theme = tab.Window.Theme
	local element = elementBase(tab, 26)

	local row = create("Frame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 26),
	})
	local label = create("TextLabel", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.new(1, -56, 1, 0),
		Font = theme.Font,
		TextSize = theme.TextSize,
		TextColor3 = theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = text,
	})
	label.Parent = row

	local track = create("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		BackgroundColor3 = theme.Element,
		BorderSizePixel = 0,
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(40, 20),
		Active = true,
	})
	track.Parent = row
	round(track, 10, false)

	local knob = create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundColor3 = theme.Text,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 3, 0.5, 0),
		Size = UDim2.fromOffset(14, 14),
	})
	knob.Parent = track
	round(knob, 7)

	local value = default == true

	local function apply(animate)
		local target = value and UDim.new(0, 23) or UDim.new(0, 3)
		if animate then
			tween(knob, { Position = UDim2.new(target.X, 0, 0.5, 0) }, 0.15)
			tween(track, { BackgroundColor3 = value and theme.Accent or theme.Element }, 0.15)
		else
			knob.Position = UDim2.new(target.X, 0, 0.5, 0)
			track.BackgroundColor3 = value and theme.Accent or theme.Element
		end
	end

	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			value = not value
			apply(true)
		end
	end)

	element.Frame = row
	element.Value = value
	element.SetValue = function(_, newValue)
		value = newValue == true
		element.Value = value
		apply(false)
	end
	element.Changed = function(_, newValue)
		value = newValue == true
		element.Value = value
		apply(false)
	end

	apply(false)
	return tab.Add(element)
end

function UILib:Slider(text, minimum, maximum, default, callback)
	local tab = self
	local theme = tab.Window.Theme
	local element = elementBase(tab, 44)

	local row = create("Frame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 44),
	})
	local label = create("TextLabel", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.new(1, -70, 0, 18),
		Font = theme.Font,
		TextSize = theme.TextSize,
		TextColor3 = theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = text,
	})
	label.Parent = row

	local valueLabel = create("TextLabel", {
		AnchorPoint = Vector2.new(1, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.fromOffset(70, 18),
		Font = theme.Font,
		TextSize = theme.TextSize,
		TextColor3 = theme.SubText,
		TextXAlignment = Enum.TextXAlignment.Right,
	})
	valueLabel.Parent = row

	local track = create("Frame", {
		BackgroundColor3 = theme.Element,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, 26),
		Size = UDim2.new(1, 0, 0, 6),
		Active = true,
	})
	track.Parent = row
	round(track, 3, false)

	local fill = create("Frame", {
		BackgroundColor3 = theme.Accent,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(0, 1),
	})
	fill.Parent = track
	round(fill, 3)

	local knob = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = theme.Text,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, 3),
		Size = UDim2.fromOffset(14, 14),
		Active = true,
	})
	knob.Parent = track
	round(knob, 7)

	local value = default or minimum
	local dragging = false

	local function apply()
		local fraction = (value - minimum) / (maximum - minimum)
		fraction = clamp(fraction, 0, 1)
		fill.Size = UDim2.fromScale(fraction, 1)
		knob.Position = UDim2.new(fraction, 0, 0.5, 0)
		valueLabel.Text = tostring(math.floor(value * 100) / 100)
		element.Value = value
		if callback then
			callback(value)
		end
	end

	local function fromInput(input)
		local x
		if input.UserInputType == Enum.UserInputType.Touch then
			x = input.Position.X
		else
			x = input.X
		end
		if not x then
			return
		end
		local fraction = (x - track.AbsolutePosition.X) / track.AbsoluteSize.X
		fraction = clamp(fraction, 0, 1)
		value = minimum + (maximum - minimum) * fraction
		apply()
	end

	knob.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			fromInput(input)
		end
	end)

	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			fromInput(input)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if not dragging then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			fromInput(input)
		end
	end)

	UserInputService.InputUp:Connect(function()
		dragging = false
	end)

	element.Frame = row
	element.Value = value
	element.SetValue = function(_, newValue)
		value = clamp(newValue, minimum, maximum)
		apply()
	end

	apply()
	return tab.Add(element)
end

function UILib:Textbox(text, placeholder, default)
	local tab = self
	local theme = tab.Window.Theme
	local element = elementBase(tab, 34)

	local row = create("Frame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 34),
	})
	local label = create("TextLabel", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 16),
		Font = theme.Font,
		TextSize = 13,
		TextColor3 = theme.SubText,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = text,
	})
	label.Parent = row

	local box = create("TextBox", {
		BackgroundColor3 = theme.Element,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, 18),
		Size = UDim2.new(1, 0, 0, 26),
		Font = theme.Font,
		TextSize = theme.TextSize,
		TextColor3 = theme.Text,
		PlaceholderText = placeholder or "",
		PlaceholderColor3 = theme.SubText,
		Text = default or "",
		TextXAlignment = Enum.TextXAlignment.Left,
		ClearTextOnFocus = false,
	})
	box.Parent = row
	round(box, theme.Radius)

	element.Frame = row
	element.Value = default or ""
	element.GetValue = function()
		return box.Text
	end
	element.SetValue = function(_, newValue)
		box.Text = newValue
		element.Value = newValue
	end

	return tab.Add(element)
end

function UILib:Dropdown(text, options, default)
	local tab = self
	local theme = tab.Window.Theme
	local element = elementBase(tab, 34)

	local row = create("Frame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 34),
	})
	local label = create("TextLabel", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 16),
		Font = theme.Font,
		TextSize = 13,
		TextColor3 = theme.SubText,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = text,
	})
	label.Parent = row

	local button = create("TextButton", {
		BackgroundColor3 = theme.Element,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, 18),
		Size = UDim2.new(1, 0, 0, 26),
		Font = theme.Font,
		TextSize = theme.TextSize,
		TextColor3 = theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = tostring(default or options[1]),
		AutoButtonColor = false,
	})
	button.Parent = row
	round(button, theme.Radius)

	local list = create("Frame", {
		BackgroundColor3 = theme.Element,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, 46),
		Size = UDim2.new(1, 0, 0, 0),
		Visible = false,
		ZIndex = 20,
	})
	list.Parent = row
	round(list, theme.Radius)
	outline(list, theme.Border, 1)

	local value = default or options[1]
	local open = false
	local setOpen

	for index, option in ipairs(options) do
		local optionValue = option
		local optionButton = create("TextButton", {
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Position = UDim2.fromOffset(0, (index - 1) * 26),
			Size = UDim2.new(1, 0, 0, 26),
			Font = theme.Font,
			TextSize = theme.TextSize,
			TextColor3 = theme.Text,
			TextXAlignment = Enum.TextXAlignment.Left,
			Text = tostring(option),
			AutoButtonColor = false,
			ZIndex = 20,
		})
		optionButton.Parent = list

		optionButton.MouseButton1Click:Connect(function()
			value = optionValue
			button.Text = tostring(optionValue)
			element.Value = optionValue
			setOpen(false)
		end)
	end

	setOpen = function(state)
		open = state
		list.Visible = state
		row.ZIndex = state and 30 or 1
		list.Size = UDim2.new(1, 0, 0, state and #options * 26 or 0)
		element.Height = state and (34 + #options * 26 + 6) or 34
		tab.Refresh()
	end

	button.MouseButton1Click:Connect(function()
		setOpen(not open)
	end)

	element.Frame = row
	element.Value = value
	element.SetValue = function(_, newValue)
		value = newValue
		button.Text = tostring(newValue)
	end

	return tab.Add(element)
end

return UILib
